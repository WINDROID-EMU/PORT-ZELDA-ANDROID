    <!-- Shader Presets -->
    <string name="shader_preset_none">None (Original Pixel Art)</string>
    <string name="shader_desc_none">Classic native pixel art rendering without additional post-processing.</string>
    <string name="shader_preset_sharp_bilinear">Sharp Bilinear (Pixel-Perfect / Anti-Shimmering)</string>
    <string name="shader_desc_sharp_bilinear">Maximum pixel sharpness without distortion or shimmering artifacts when scrolling.</string>
    <string name="shader_preset_sharp_scanlines">Sharp Bilinear + Scanlines (Crisp with Scanlines)</string>
    <string name="shader_desc_sharp_scanlines">Sharp pixels combined with subtle retro TV scanlines.</string>
    <string name="shader_preset_adv_sharpening">Advanced Sharpening (High Sharpness / CAS)</string>
    <string name="shader_desc_adv_sharpening">Adaptive high-sharpness filter enhancing sprite edges, textures, and details.</string>
    <string name="shader_preset_scale2x">Scale2x / AdvMame (Smoothed Pixel Art)</string>
    <string name="shader_desc_scale2x">Smart algorithm that smooths pixel staircasing while preserving contours.</string>
    <string name="shader_preset_hq2x">HQ2x (High Quality Smooth)</string>
    <string name="shader_desc_hq2x">Advanced 2x interpolation and smoothing filter for high-fidelity pixel art.</string>
    <string name="shader_preset_crt_easymode">CRT-Easymode (Classic Tube TV / Scanlines)</string>
    <string name="shader_desc_crt_easymode">Authentic CRT retro monitor simulation with scanlines, phosphor mask, and bloom.</string>
    <string name="shader_preset_bicubic">Bicubic Sharpen (Crisp Bicubic Filter)</string>
    <string name="shader_desc_bicubic">Smooth bicubic interpolation with sharpness enhancement for modern displays.</string>
    <string name="shader_preset_lcd_grid">LCD Grid (Handheld LCD Grid)</string>
    <string name="shader_desc_lcd_grid">Simulates the pixel grid of classic handheld LCD screens with uniform clarity.</string>
    <string name="shader_preset_vibrant">Vibrant Enhancer (Vivid Colors &amp; Contrast)</string>
    <string name="shader_desc_vibrant">Boosts color contrast, saturation, and vibrancy on OLED and IPS displays.</string>
    <string name="shader_preset_custom">Custom (Custom .glsl file)</string>
    <string name="shader_desc_custom">Load a custom shader file from internal or external storage.</string>

