    <!-- Shader Presets -->
    <string name="shader_preset_none">Nenhum (Pixel Art Original)</string>
    <string name="shader_desc_none">Renderização nativa pixel art clássica sem pós-processamento adicional.</string>
    <string name="shader_preset_sharp_bilinear">Sharp Bilinear (Nitidez Perfeita / Anti-Shimmering)</string>
    <string name="shader_desc_sharp_bilinear">Nitidez máxima dos pixels sem distorções ou ondulações ao movimentar a câmera.</string>
    <string name="shader_preset_sharp_scanlines">Sharp Bilinear + Scanlines (Nítido com Scanlines)</string>
    <string name="shader_desc_sharp_scanlines">Pixels nítidos combinados com linhas de varredura (scanlines) sutis estilo TV retrô.</string>
    <string name="shader_preset_adv_sharpening">Advanced Sharpening (Nitidez Aprimorada / CAS)</string>
    <string name="shader_desc_adv_sharpening">Filtro adaptativo de alta nitidez que realça bordas, texturas e detalhes dos sprites.</string>
    <string name="shader_preset_scale2x">Scale2x / AdvMame (Pixel Art Suavizado)</string>
    <string name="shader_desc_scale2x">Algoritmo inteligente que suaviza escadas de pixels em diagonais preservando contornos.</string>
    <string name="shader_preset_hq2x">HQ2x (Alta Qualidade Suave)</string>
    <string name="shader_desc_hq2x">Filtro avançado de interpolação e suavização 2x de alta fidelidade para pixel art.</string>
    <string name="shader_preset_crt_easymode">CRT-Easymode (TV Tubo Clássica / Scanlines)</string>
    <string name="shader_desc_crt_easymode">Simulação autêntica de monitor CRT retrô com scanlines, máscara de fósforo e contraste.</string>
    <string name="shader_preset_bicubic">Bicubic Sharpen (Filtro Bicúbico Nítido)</string>
    <string name="shader_desc_bicubic">Interpolação bicúbica suave com realce de nitidez para resoluções modernas.</string>
    <string name="shader_preset_lcd_grid">LCD Grid (Matriz de LCD Portátil)</string>
    <string name="shader_desc_lcd_grid">Simula a matriz de grade de tela LCD retrô portátil com nitidez uniforme.</string>
    <string name="shader_preset_vibrant">Vibrant Enhancer (Cores Vivas &amp; Alto Contraste)</string>
    <string name="shader_desc_vibrant">Acentua o contraste, saturação e vivacidade das cores em telas OLED e IPS.</string>
    <string name="shader_preset_custom">Personalizado (.glsl customizado)</string>
    <string name="shader_desc_custom">Carrega um arquivo shader customizado do armazenamento interno ou externo.</string>

