                    <CheckBox
                        android:id="@+id/cb_skip_dialogue_a"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cb_skip_dialogue_a"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <CheckBox
                        android:id="@+id/cb_max_hearts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cb_max_hearts"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />
                </LinearLayout>
            </ScrollView>

            <!-- Panel 5: Editor Direto (.ini) -->
            <LinearLayout
                android:id="@+id/panel_raw_ini"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:text="@string/section_raw_ini_title"
                        android:textColor="#FFD700"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_reload_raw"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_alignParentRight="true"
                        android:background="@drawable/btn_dark"
                        android:text="@string/btn_reload_raw"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp" />
                </RelativeLayout>

                <EditText
                    android:id="@+id/et_raw_ini"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_bg"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:gravity="top|left"
                    android:padding="8dp"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:scrollbars="vertical"
                    android:typeface="monospace" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
